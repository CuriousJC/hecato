*.log

#####Claude Code Ignore
# Project-scoped Claude Code permission allowlist. Written by approving prompts
# during a session, so it accumulates one-off command strings that never match
# again. Kept local rather than shared. `settings.local.json` is separately
# ignored globally in ~/.config/git/ignore.
#
# If this ever becomes worth sharing, it needs `git add -f`.
.claude/settings.json

# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# The linux build artifact from `make build-linux`. Extensionless, so the *.exe
# rule above only catches its windows twin. Anchored to the repo root so it
# can't shadow cmd/hecato/ or the module name.
/hecato

# The live config. hecato looks for hecato.yaml beside the executable, and a
# local build puts the executable here, so this is a working file that would
# otherwise show up dirty every time it is tweaked. The committed reference
# copy is hecato.example.yaml, which is tracked.
/hecato.yaml

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
# go.work  #I want to include this at least for now
